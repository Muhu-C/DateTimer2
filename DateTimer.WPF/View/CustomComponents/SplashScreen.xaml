<UserControl x:Class="DateTimer.WPF.View.CustomComponents.SplashScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DateTimer.WPF.View.CustomComponents"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             mc:Ignorable="d" 
             Background="{DynamicResource {x:Static ui:ThemeKeys.ExpanderHeaderBackgroundKey}}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="0.8*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.618*"/>
            <RowDefinition Height="0.6*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Image Source="/Data/icon.png" RenderOptions.BitmapScalingMode="HighQuality" Grid.Row="1" Grid.Column="1"/>
        <ui:ProgressRing Grid.Row="2" Grid.Column="1"/>
    </Grid>
</UserControl>
